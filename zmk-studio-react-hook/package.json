{
  "name": "@zmkfirmware/zmk-studio-react-hook",
  "version": "0.0.1",
  "description": "React hooks wrapper for @zmkfirmware/zmk-studio-ts-client",
  "license": "MIT",
  "author": {
    "name": "ZMK Project",
    "email": "petejohason@users.noreply.github.com",
    "url": "https://github.com/zmkfirmware"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib/**/*"
  ],
  "scripts": {
